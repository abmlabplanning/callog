# ── Supabase PostgreSQL (Prisma) ──────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ── Vercel Blob (파일 업로드) ──────────────────────────────────────────────────
# Vercel 프로젝트 → Storage → Create Blob Store → 서버 프로젝트에 연결 (자동 주입)
BLOB_READ_WRITE_TOKEN=""

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="랜덤_32자이상_문자열"
JWT_REFRESH_SECRET="랜덤_32자이상_문자열"

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ── Client ─────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000/api
